{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "h3xBoard (mobile, debug)",
            "request": "launch",
            "type": "dart",
        },
        {
            "name": "h3xBoard (mobile, profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "h3xBoard (mobile, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "h3xBoard (web, debug)",
            "request": "launch",
            "type": "dart",
            "args": ["--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080, debug)",
            "request": "launch",
            "type": "dart",
            "args": ["--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080, profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
    ]
}
