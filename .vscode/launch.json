{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "h3xBoard (mobile)",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "h3xBoard (web)",
            "request": "launch",
            "type": "dart",
            "args": ["--wasm", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--wasm", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--wasm", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080)",
            "request": "launch",
            "type": "dart",
            "args": ["--wasm", "--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080, profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--wasm", "--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
        {
            "name": "h3xBoard (web, public :8080, release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--wasm", "--web-hostname=0.0.0.0", "--web-port=8080", "--web-browser-flag=--disable-web-security"]
        },
    ]
}
